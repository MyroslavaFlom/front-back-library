PORT=3000

# MongoDB Atlas (Connect → Drivers). Спецсимволи в паролі кодуйте: @ → %40, : → %3A, / → %2F, # → %23
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.<xxxxx>.mongodb.net/?retryWrites=true&w=majority&appName=<app-name>
# Локальна база (альтернатива):
# MONGO_URI=mongodb://localhost:27017

DB_NAME=library_service

# Секрет підпису cookie сесії (у production — щонайменше 32 символи).
# Згенерувати: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<long-random-string>

# Адміністратор, якого створює/оновлює `npm run seed`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-password>

# Origin клієнта для CORS (кілька — через кому). За замовчуванням http://localhost:5173.
# CLIENT_ORIGIN=http://localhost:5173

# Secure-cookie вмикається в production автоматично; для локального `npm start` по http задайте false.
# COOKIE_SECURE=false

# Кількість довірених reverse-proxy (HTTPS-термінація перед сервером). 0 — без проксі.
# TRUST_PROXY=1
